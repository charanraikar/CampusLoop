# Optional: Node does not load this automatically.
# Copy to .env, then run: node --env-file=.env server.js
HOST=127.0.0.1
PORT=3000
DEMO_MODE=true
SECURE_COOKIES=false
# DB_PATH=data/campusloop.db
# ADMIN_EMAIL=your-admin-email
# ADMIN_PASSWORD=choose-at-least-14-characters-in-your-private-env-file

# --- Razorpay (leave blank to keep simulated payments) ---
# Get test keys: Razorpay Dashboard -> Account & Settings -> API Keys (Test Mode)
 RAZORPAY_KEY_ID=rzp_test_U2t31eXT9XU4F6
 RAZORPAY_KEY_SECRET=5c3sVqXup20XMK8thHrXy1Jl
# Optional but recommended: Dashboard -> Webhooks -> URL https://YOUR-APP.onrender.com/api/razorpay/webhook
# events: payment.captured, order.paid
# RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# --- Email (password reset, verification, order alerts) ---
# Option A (free, no domain needed): Brevo, 300 emails/day. See docs/DEPLOY_RENDER.md.
# BREVO_API_KEY=xkeysib-xxxxxxxx
# MAIL_FROM_EMAIL=your-verified-sender@gmail.com
# MAIL_FROM_NAME=CampusLoop
# Option B: Resend (only delivers to other people once you verify a domain you own)
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=CampusLoop <onboarding@resend.dev>
# With neither, emails are printed in the server terminal instead.
# Public address of your site, used inside email links (no trailing slash)
# APP_URL=https://your-app.onrender.com
# Set to true when hosted behind a proxy such as Render, so rate limits use real visitor IPs
# TRUST_PROXY=true
